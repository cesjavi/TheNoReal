{
  "name": "thenoreal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "postinstall": "prisma generate",
    "prisma:gen": "prisma generate --schema=prisma/schema.prisma",
    "start": "next start",
    "lint": "next lint",
    "db:push": "DATABASE_URL=$DATABASE_URL_UNPOOLED prisma db push",
    "build": "npm run db:push && next build"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "groq-sdk": "^0.30.0",
    "next": "15.4.6",
    "next-intl": "^3.26.5",
    "next-pwa": "^5.6.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@swc/core": "^1.13.3",
    "@swc/jest": "^0.2.36",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.1.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "prisma": "^6.14.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
