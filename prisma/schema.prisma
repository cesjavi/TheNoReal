// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum EndingMode {
  CAPITULOS
  SIN_FINAL_DEFINIDO
  FINAL_SORPRESA
  INFINITA
}

model Story {
  id                 String     @id @default(cuid())
  optionsPerDecision Int
  endingMode         EndingMode
  chaptersCount      Int?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}
